# --- Forge Compliance deploy config ---  (copy to .env, then `docker compose up -d`)
# Image tags are pinned to this release by CI.
BACKEND_IMAGE=ghcr.io/dpbattaglia-gps/forge_compliance-app-backend:v1.3.20
FRONTEND_IMAGE=ghcr.io/dpbattaglia-gps/forge_compliance-app-frontend:v1.3.20

# Port served behind your Cloudflare Tunnel / reverse proxy
HTTP_PORT=8080

DB_NAME=forge_compliance

# REQUIRED — long random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# 1 when served over HTTPS (Cloudflare), 0 for plain-HTTP LAN testing
COOKIE_SECURE=1

# Public URL used in emails/links, e.g. https://app.yourcompany.com
APP_BASE_URL=
CORS_ORIGINS=

# Licence server this instance activates/validates against
LICENCE_SERVER_URL=https://forgecompliance.org

# Email (optional; also settable in Settings -> SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudflare Access SSO (optional; also settable in Settings -> Integrations)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=
# Comma-separated PUBLIC hostname(s) served behind Cloudflare Access (e.g. forge.example.com).
# On these hosts the built-in email/password form is hidden and only company SSO is shown, so
# there's no password "flash" during logout. Leave blank for LAN/direct access where password
# login (break-glass) should remain available. Requires the reverse proxy to forward Host /
# X-Forwarded-Host, which the app trusts via uvicorn --proxy-headers.
CF_ACCESS_HOSTS=

# Automatic nightly backups (optional). Set BACKUP_DIR to a mounted folder/NAS path
# INSIDE the backend container (see docker-compose volume) to write a full .zip
# (data + all files) on a schedule. Leave BACKUP_DIR blank to disable.
BACKUP_DIR=/backups
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24

# Web Push (optional) — closed-app worker reminders when an offline sign-on stays unsynced.
# Generate ONCE per install (keys must stay stable or existing subscriptions break):
#   pip install py-vapid && vapid --gen --applicationServerKey
# Put the printed "Application Server Key" in VAPID_PUBLIC_KEY, keep private_key.pem mounted
# inside the backend container, and point VAPID_PRIVATE_KEY_PATH at it. Leave blank to disable
# push (workers still get in-app reminders while the app is open).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PATH=secrets/private_key.pem
VAPID_SUBJECT=mailto:admin@yourcompany.com

# --- Cluster administration (replica-set installs only; see MULTI_SERVER_SETUP.md) ---
# Optional. A Mongo user with clusterMonitor + clusterManager roles unlocks the live
# Settings -> Servers dashboard and its guarded step-down / promote / re-add buttons.
# Leave blank on single-server installs (the Servers tab then just shows "standalone").
MONGO_CLUSTER_URL=
# This node's own replica-set member address (usually NEBULA_IP:27017) so the page can
# say "this server is PRIMARY/STANDBY".
CLUSTER_SELF_HOST=
# Stable name for THIS server on the Servers version list (e.g. forge-1). Recommended even on
# a single server: without it the container hostname is used, which changes on every app update
# and leaves old versions of the same box showing as "offline" ghosts. Ghost heartbeats are
# also auto-pruned after NODE_RETENTION_HOURS (default 24).
NODE_ID=
#NODE_RETENTION_HOURS=24
