# --- Forge Compliance deploy config ---  (copy to .env, then `docker compose up -d`)
# Image tags are pinned to this release by CI.
BACKEND_IMAGE=ghcr.io/dpbattaglia-gps/forge-compliance-backend:V1.0.0
FRONTEND_IMAGE=ghcr.io/dpbattaglia-gps/forge-compliance-frontend:V1.0.0

# Port served behind your Cloudflare Tunnel / reverse proxy
HTTP_PORT=8080

DB_NAME=forge_compliance

# REQUIRED — long random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# 1 when served over HTTPS (Cloudflare), 0 for plain-HTTP LAN testing
COOKIE_SECURE=1

# Public URL used in emails/links, e.g. https://app.yourcompany.com
APP_BASE_URL=
CORS_ORIGINS=

# Licence server this instance activates/validates against
LICENCE_SERVER_URL=https://forgecompliance.org

# Email (optional; also settable in Settings -> SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudflare Access SSO (optional; also settable in Settings -> Integrations)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=
